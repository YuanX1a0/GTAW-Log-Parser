<Controls:MetroWindow x:Name="Main" x:Class="Assistant.UI.MainWindow"
                      xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:local="clr-namespace:Assistant.UI"
                      mc:Ignorable="d"
                      ResizeMode="CanResize"
                      WindowStartupLocation="CenterScreen"
                      Closing="Main_Closing"
                      WindowTransitionsEnabled="True"
                      GlowBrush="Transparent"
                      BorderThickness="0"
                      WindowTitleBrush="{DynamicResource FluentCardBackground}"
                      TitleForeground="{DynamicResource FluentTextForeground}"
                      FontFamily="Microsoft YaHei" FontWeight="Normal"
                      Title=""
                      Height="640" Width="940" MinHeight="480" MinWidth="720"
                      IsMaxRestoreButtonEnabled="True" IsMinButtonEnabled="True" TitleCaps="False" ShowIconOnTitleBar="False" Icon="../Resources/AppIcon.ico">

    <Controls:MetroWindow.WindowButtonCommands>
        <Controls:WindowButtonCommands
                                       Foreground="{DynamicResource FluentTextForeground}"
                                       LightCloseButtonStyle="{StaticResource MahApps.Metro.Styles.WindowButton.Close.Light.Win10}"
                                       DarkCloseButtonStyle="{StaticResource MahApps.Metro.Styles.WindowButton.Close.Dark.Win10}"/>
    </Controls:MetroWindow.WindowButtonCommands>

    <Grid Background="{DynamicResource FluentWindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧导航 ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource FluentCardBackground}" BorderBrush="{DynamicResource FluentBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,10">
                    <TextBlock x:Name="AppTitle" Text="GTA World聊天助手" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,10,16,16">
                    <TextBlock x:Name="Version" FontSize="12" Foreground="{DynamicResource FluentSecondaryForeground}" TextAlignment="Center" Text="v6.1.0"/>
                </StackPanel>

                <StackPanel Margin="10,6,10,10">
                    <Button x:Name="NavOverview" Click="NavOverview_Click" HorizontalContentAlignment="Left" Padding="10,9" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ViewDashboard" Width="16" Height="16" Foreground="{DynamicResource FluentTextForeground}"/>
                            <TextBlock x:Name="NavOverviewText" Text="总览" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavChatLog" Click="NavChatLog_Click" HorizontalContentAlignment="Left" Padding="10,9" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="MessageText" Width="16" Height="16" Foreground="{DynamicResource FluentTextForeground}"/>
                            <TextBlock x:Name="NavChatLogText" Text="聊天日志" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavTranslation" Click="NavTranslation_Click" HorizontalContentAlignment="Left" Padding="10,9" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Translate" Width="16" Height="16" Foreground="{DynamicResource FluentTextForeground}"/>
                            <TextBlock x:Name="NavTranslationText" Text="翻译" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavApiUsage" Click="NavApiUsage_Click" HorizontalContentAlignment="Left" Padding="10,9" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ChartLine" Width="16" Height="16" Foreground="{DynamicResource FluentTextForeground}"/>
                            <TextBlock x:Name="NavApiUsageText" Text="API用量" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavRealtimeLog" Click="NavRealtimeLog_Click" HorizontalContentAlignment="Left" Padding="10,9" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Pulse" Width="16" Height="16" Foreground="{DynamicResource FluentTextForeground}"/>
                            <TextBlock x:Name="NavRealtimeLogText" Text="实时日志" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="{DynamicResource FluentBorderBrush}" Margin="6,10"/>

                    <Button x:Name="NavFilter" Click="NavFilter_Click" HorizontalContentAlignment="Left" Padding="10,9" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Filter" Width="16" Height="16" Foreground="{DynamicResource FluentTextForeground}"/>
                            <TextBlock x:Name="NavFilterText" Text="过滤日志" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Click="NavSettings_Click" HorizontalContentAlignment="Left" Padding="10,9" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Settings" Width="16" Height="16" Foreground="{DynamicResource FluentTextForeground}"/>
                            <TextBlock x:Name="NavSettingsText" Text="设置" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavAbout" Click="NavAbout_Click" HorizontalContentAlignment="Left" Padding="10,9" Margin="0,2">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Information" Width="16" Height="16" Foreground="{DynamicResource FluentTextForeground}"/>
                            <TextBlock x:Name="NavAboutText" Text="关于" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== 右侧内容 ==================== -->
        <Grid Grid.Column="1" Margin="28,20,28,20">
            <!-- 总览页 -->
            <Grid x:Name="OverviewPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="OverviewTitle" Text="总览" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <UniformGrid Columns="2" Rows="2">
                            <Border Background="{DynamicResource FluentCardBackground}" BorderBrush="{DynamicResource FluentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22,18" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock x:Name="TotalTranslationsValue" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource FluentAccentBrush}"/>
                                    <TextBlock x:Name="TotalTranslationsLabel" Text="累积翻译次数" FontSize="13" Foreground="{DynamicResource FluentSecondaryForeground}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource FluentCardBackground}" BorderBrush="{DynamicResource FluentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22,18" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock x:Name="TotalCharactersValue" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource FluentAccentBrush}"/>
                                    <TextBlock x:Name="TotalCharactersLabel" Text="词语翻译次数" FontSize="13" Foreground="{DynamicResource FluentSecondaryForeground}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource FluentCardBackground}" BorderBrush="{DynamicResource FluentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22,18" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock x:Name="TotalApiCallsValue" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource FluentAccentBrush}"/>
                                    <TextBlock x:Name="TotalApiCallsLabel" Text="API调用次数" FontSize="13" Foreground="{DynamicResource FluentSecondaryForeground}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource FluentCardBackground}" BorderBrush="{DynamicResource FluentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22,18">
                                <StackPanel>
                                    <TextBlock x:Name="TotalTokensValue" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource FluentAccentBrush}"/>
                                    <TextBlock x:Name="TotalTokensLabel" Text="Token消耗" FontSize="13" Foreground="{DynamicResource FluentSecondaryForeground}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="{DynamicResource FluentCardBackground}" BorderBrush="{DynamicResource FluentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22,18" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Button x:Name="TopWordsToggle" Click="TopWordsToggle_Click" Style="{StaticResource FluentTitleButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TopWordsArrow" Text="▸" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource FluentSecondaryForeground}"/>
                                        <TextBlock x:Name="TopWordsTitle" Text="翻译次数最多的单词" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <ItemsControl x:Name="TopWordsList" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Rank}" Foreground="{DynamicResource FluentSecondaryForeground}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Word}" Foreground="{DynamicResource FluentTextForeground}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="{DynamicResource FluentAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource FluentCardBackground}" BorderBrush="{DynamicResource FluentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22,18" Margin="0,10,0,0" MaxHeight="320">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="CacheToggleButton" Click="CacheToggleButton_Click" Style="{StaticResource FluentTitleButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="CacheArrow" Text="▸" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource FluentSecondaryForeground}"/>
                                            <TextBlock x:Name="CacheTitle" Text="翻译缓存" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="CacheInfo" Grid.Column="1" Text="" FontSize="12" Foreground="{DynamicResource FluentSecondaryForeground}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="RefreshCacheButton" Grid.Column="2" Content="刷新" FontSize="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center" Click="RefreshCacheButton_Click"/>
                                </Grid>
                                <ListBox x:Name="CacheList" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Source}" FontWeight="SemiBold" Foreground="{DynamicResource FluentTextForeground}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Translation}" FontSize="12" Foreground="{DynamicResource FluentSecondaryForeground}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- API用量页 -->
            <Grid x:Name="ApiUsagePage" Visibility="Collapsed">
                <Border Background="White" CornerRadius="8">
                    <Grid Margin="18,14,18,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ApiUsageTitle" Text="API 用量" FontSize="24" FontWeight="SemiBold" Foreground="#222222"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock x:Name="ApiUsageRangeLabel" Text="时间范围：" FontSize="13" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ApiUsageRangeList" Width="140" SelectionChanged="ApiUsageRangeList_SelectionChanged" VerticalAlignment="Center" FontSize="13"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                            <StackPanel x:Name="ApiUsageCardsPanel"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 聊天日志页 -->
            <Grid x:Name="ChatLogPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="ChatLogTitle" Text="聊天日志" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14"/>

                <TextBox x:Name="Parsed" Grid.Row="1" Style="{StaticResource FluentChatTextBox}"
                         TextChanged="Parsed_TextChanged"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Visible"/>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="Parse" Style="{StaticResource FluentAccentButton}" Click="Parse_Click"/>
                        <Button x:Name="SaveParsed" Click="SaveParsed_Click" Margin="8,0,0,0"/>
                        <Button x:Name="CopyParsedToClipboard" Click="CopyParsedToClipboard_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="Counter" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource FluentSecondaryForeground}" FontSize="12"/>
                </Grid>

                <Border Grid.Row="3" Height="1" Background="{DynamicResource FluentBorderBrush}" Margin="0,12,0,8"/>
                <TextBlock x:Name="StatusLabel" Grid.Row="4" Foreground="{DynamicResource FluentSecondaryForeground}" FontSize="12"/>
            </Grid>

            <!-- 翻译页 -->
            <ScrollViewer x:Name="TranslationPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,24,20">
                    <TextBlock x:Name="TranslationTitle" Text="翻译" FontSize="24" FontWeight="SemiBold"/>

                    <TextBlock x:Name="SectionGeneral" Style="{StaticResource FluentSectionHeader}" Text="常规"/>

                    <CheckBox x:Name="TranslationEnabled" Margin="0,6,0,0"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="TargetLanguageLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TargetLanguageList" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SourceLanguageLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SourceLanguageList" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="TranslationBulkHotkeyLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="TranslationBulkHotkeyBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <CheckBox x:Name="AutoTranslateCheckBox" Margin="0,6,0,0"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="AutoTranslateHotkeyLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="AutoTranslateHotkeyBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <CheckBox x:Name="ShowGameToastsCheckBox" Margin="0,6,0,0"/>

                    <TextBlock x:Name="SectionGameTranslation" Style="{StaticResource FluentSectionHeader}" Text="游戏功能翻译"/>

                    <CheckBox x:Name="SettingsPageTranslationCheckBox" Margin="0,2,0,0"/>

                    <TextBlock x:Name="SectionProvider" Style="{StaticResource FluentSectionHeader}" Text="翻译服务"/>

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="TranslationProviderLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TranslationProviderList" Grid.Column="1" SelectionChanged="TranslationProviderList_SelectionChanged" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="DeepSeekApiKeyRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="DeepSeekApiKeyLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="DeepSeekApiKeyBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="DeepSeekModelRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="DeepSeekModelLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="DeepSeekModelList" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="DeepSeekSpeedRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="DeepSeekSpeedLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="DeepSeekSpeedList" Grid.Column="1" SelectionChanged="DeepSeekSpeedList_SelectionChanged" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="DeepLApiKeyRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="DeepLApiKeyLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="DeepLApiKeyBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="DoubaoApiKeyRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="DoubaoApiKeyLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="DoubaoApiKeyBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="DoubaoModelRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="DoubaoModelLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="DoubaoModelList" Grid.Column="1" IsEditable="True" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="CustomProviderRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="CustomProviderLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CustomProviderList" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="280"/>
                    </Grid>
                    <Grid x:Name="CustomEndpointRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="CustomEndpointLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="CustomEndpointBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="420"/>
                    </Grid>
                    <Grid x:Name="CustomApiKeyRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="CustomApiKeyLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="CustomApiKeyBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="CustomModelRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="CustomModelLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <DockPanel Grid.Column="1">
                            <Button x:Name="CustomModelAddButton" DockPanel.Dock="Right" Width="60" Height="26" Margin="6,0,0,0" Content="+" Click="CustomModelAddButton_Click"/>
                            <ComboBox x:Name="CustomModelList" IsEditable="True" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </DockPanel>
                    </Grid>
                    <Grid x:Name="ZoomApiKeyRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="ZoomApiKeyLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="ZoomApiKeyBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="TranslationDisplayModeLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TranslationDisplayModeList" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="EnableCacheRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="EnableCacheLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="EnableCacheCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="FuzzyCacheRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="FuzzyCacheLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="FuzzyCacheCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid x:Name="TranslationPromptRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="TranslationPromptLabel" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <TextBox x:Name="TranslationPromptBox" Grid.Column="1" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid x:Name="TranslationStyleRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="TranslationStyleLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TranslationStyleList" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>

                    <TextBlock x:Name="SectionSend" Style="{StaticResource FluentSectionHeader}" Text="发送翻译"/>

                    <CheckBox x:Name="SendTranslationEnabled" Margin="0,2,0,0" Checked="SendTranslationEnabled_Changed" Unchecked="SendTranslationEnabled_Changed"/>
                    <CheckBox x:Name="EnableManualTranslateCheckBox" Margin="0,6,0,0"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendSourceLanguageLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SendSourceLanguageList" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendTargetLanguageLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SendTargetLanguageList" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendTranslationKeyLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SendTranslationKeyBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendProviderLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SendProviderList" Grid.Column="1" SelectionChanged="SendProviderList_SelectionChanged" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="SendApiKeyRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendApiKeyLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="SendApiKeyBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="SendModelRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendModelLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SendModelList" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="SendSpeedRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendSpeedLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SendSpeedList" Grid.Column="1" SelectionChanged="SendSpeedList_SelectionChanged" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="SendDeepLApiKeyRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendDeepLApiKeyLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="SendDeepLApiKeyBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="SendDoubaoApiKeyRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendDoubaoApiKeyLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="SendDoubaoApiKeyBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="SendDoubaoModelRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendDoubaoModelLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SendDoubaoModelList" Grid.Column="1" IsEditable="True" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="SendCustomProviderRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendCustomProviderLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SendCustomProviderList" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="280"/>
                    </Grid>
                    <Grid x:Name="SendCustomEndpointRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendCustomEndpointLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SendCustomEndpointBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="420"/>
                    </Grid>
                    <Grid x:Name="SendCustomApiKeyRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendCustomApiKeyLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="SendCustomApiKeyBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="SendCustomModelRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendCustomModelLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <DockPanel Grid.Column="1">
                            <Button x:Name="SendCustomModelAddButton" DockPanel.Dock="Right" Width="60" Height="26" Margin="6,0,0,0" Content="+" Click="SendCustomModelAddButton_Click"/>
                            <ComboBox x:Name="SendCustomModelList" IsEditable="True" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </DockPanel>
                    </Grid>
                    <Grid x:Name="SendZoomApiKeyRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendZoomApiKeyLabel" Grid.Column="0" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="SendZoomApiKeyBox" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="260"/>
                    </Grid>
                    <Grid x:Name="SendPromptRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label x:Name="SendPromptLabel" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <TextBox x:Name="SendPromptBox" Grid.Column="1" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 实时日志页 -->
            <Grid x:Name="RealtimeLogPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="RealtimeLogTitle" Text="实时日志" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RealtimeLogHint" FontSize="12" Foreground="{DynamicResource FluentSecondaryForeground}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="RefreshLogButton" Grid.Column="1" Content="刷新" FontSize="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Top" Click="RefreshLogButton_Click"/>
                    <Button x:Name="ClearLogButton" Grid.Column="2" Content="清空" FontSize="12" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Top" Click="ClearLogButton_Click"/>
                </Grid>
                <TextBox x:Name="RealtimeLogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" Margin="0,14,0,0"
                         Background="{DynamicResource FluentCardBackground}"
                         Foreground="{DynamicResource FluentTextForeground}"
                         BorderBrush="{DynamicResource FluentBorderBrush}"/>
            </Grid>

            <!-- 关于页 -->
            <Grid x:Name="AboutPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="AboutPageTitle" Text="关于" FontSize="24" FontWeight="SemiBold"/>
                <Border Grid.Row="1" Margin="0,18,0,0" MaxWidth="480" HorizontalAlignment="Left"
                        Background="{DynamicResource FluentCardBackground}"
                        BorderBrush="{DynamicResource FluentBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="GTA World 聊天助手" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AboutVersion" FontSize="13" Foreground="{DynamicResource FluentSecondaryForeground}" Margin="0,6,0,0"/>
                        <Border Height="1" Background="{DynamicResource FluentBorderBrush}" Margin="0,14"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="开发者：" FontSize="13" Foreground="{DynamicResource FluentSecondaryForeground}"/>
                            <TextBlock Text="YuanX1a0" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="项目主页：" FontSize="13" Foreground="{DynamicResource FluentSecondaryForeground}"/>
                            <TextBlock FontSize="13">
                                <Hyperlink x:Name="ProjectLink" NavigateUri="https://github.com/YuanX1a0/GTAW-Log-Parser"
                                           RequestNavigate="ProjectLink_RequestNavigate">
                                    <Run Text="https://github.com/YuanX1a0/GTAW-Log-Parser"/>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Controls:MetroWindow>
